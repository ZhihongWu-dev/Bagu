{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bagu.local/schemas/source-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifestVersion", "sources"],
  "properties": {
    "manifestVersion": { "const": 1 },
    "sources": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sourceId", "url", "pageType", "approvalStatus", "discoveryQuery", "discoveredAt"],
        "properties": {
          "sourceId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,79}$" },
          "url": { "type": "string", "format": "uri", "pattern": "^https://www\\.nowcoder\\.com/" },
          "pageType": { "enum": ["interview", "multiple-choice"] },
          "approvalStatus": { "enum": ["discovered", "approved", "rejected"] },
          "discoveryQuery": { "type": "string", "minLength": 1 },
          "discoveredAt": { "type": "string", "format": "date-time" },
          "reviewNote": { "type": "string" }
        }
      }
    }
  }
}
