{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bagu.local/schemas/annotation-submission.schema.json",
  "title": "Bagu public Nowcoder annotation submission",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "manifestVersion", "submissionId", "generatedAt", "records"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "manifestVersion": { "const": 1 },
    "submissionId": { "const": "pilot-100-v1" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "records": {
      "type": "array",
      "minItems": 59,
      "maxItems": 59,
      "items": { "$ref": "#/$defs/record" }
    }
  },
  "$defs": {
    "sourceId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,79}$" },
    "topicIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["transformer-attention", "position-encoding", "training-objectives", "sft-lora-quantization", "alignment-rlhf-dpo-grpo", "inference-serving-vllm", "kv-cache-performance", "rag-retrieval-rerank", "redis-vector-database", "agent-tool-workflow", "evaluation-safety-observability"] }
    },
    "followUpTypes": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["principle", "boundary", "debugging", "metrics", "system-design", "tradeoff"] }
    },
    "misconceptionTypes": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["concept-confusion", "missing-condition", "causal-reversal", "complexity-error", "metric-misuse"] }
    },
    "choiceSignals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cognitiveLevel", "distractorTypes", "answerCueTypes"],
      "properties": {
        "cognitiveLevel": { "enum": ["foundation", "application", "deep"] },
        "distractorTypes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["implausible", "overlap", "absolute-claim", "different-scope", "missing-condition", "non-unique-answer"] }
        },
        "answerCueTypes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["length", "position", "wording", "format", "stem-repeat"] }
        }
      }
    },
    "record": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["sourceId", "status", "skipReason"],
          "properties": {
            "sourceId": { "$ref": "#/$defs/sourceId" },
            "status": { "const": "skipped" },
            "skipReason": { "enum": ["login-unavailable", "page-missing", "insufficient-content", "irrelevant", "duplicate", "cannot-assess", "other"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["sourceId", "status", "relevance"],
          "properties": {
            "sourceId": { "$ref": "#/$defs/sourceId" },
            "status": { "const": "completed" },
            "relevance": { "enum": ["not-relevant", "uncertain"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["sourceId", "status", "relevance", "role", "recruitingStage", "topicIds", "followUpTypes", "misconceptionTypes"],
          "properties": {
            "sourceId": { "$ref": "#/$defs/sourceId" },
            "status": { "const": "completed" },
            "relevance": { "const": "relevant" },
            "role": { "enum": ["llm_algorithm", "llm_application", "shared"] },
            "recruitingStage": { "enum": ["campus-autumn", "campus-other", "unknown"] },
            "topicIds": { "$ref": "#/$defs/topicIds" },
            "followUpTypes": { "$ref": "#/$defs/followUpTypes" },
            "misconceptionTypes": { "$ref": "#/$defs/misconceptionTypes" },
            "choiceSignals": { "$ref": "#/$defs/choiceSignals" }
          }
        }
      ]
    }
  }
}
